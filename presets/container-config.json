{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label and group container image updates",
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "quadlet",
        "devcontainer",
        "buildpacks"
      ],
      "groupName": "Container image updates",
      "addLabels": [
        "container"
      ]
    }
  ]
}
