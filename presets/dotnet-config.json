{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label and group .NET ecosystem updates",
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "groupName": ".NET updates",
      "addLabels": [
        "dotnet",
        "nuget"
      ]
    }
  ]
}
