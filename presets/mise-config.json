{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/{,.}mise{,.*}.toml",
        "**/{,.}mise/config{,.*}.toml",
        "**/.config/mise{,.*}.toml",
        "**/.config/mise/{mise,config}{,.*}.toml",
        "**/.config/mise/conf.d/*.toml",
        "**/.rtx{,.*}.toml"
      ],
      "matchStrings": [
        "\"?(?:aqua:)?(?<depName>[\\w-]+)\"?\\s*=\\s*\"(?<currentValue>[^ \"]+)\"\\s*#\\s*renovate:\\s*github=(?<packageName>[\\w-]+\\/[\\w-]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "mise",
        "custom.regex"
      ],
      "matchFileNames": [
        "**/{,.}mise{,.*}.toml",
        "**/{,.}mise/config{,.*}.toml",
        "**/.config/mise{,.*}.toml",
        "**/.config/mise/{mise,config}{,.*}.toml",
        "**/.config/mise/conf.d/*.toml",
        "**/.rtx{,.*}.toml"
      ],
      "groupName": "Mise updates",
      "addLabels": [
        "mise"
      ]
    }
  ]
}
