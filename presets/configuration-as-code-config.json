{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label and group configuration-as-code updates",
  "packageRules": [
    {
      "matchManagers": [
        "ansible",
        "ansible-galaxy"
      ],
      "groupName": "Ansible updates",
      "addLabels": [
        "ansible"
      ]
    },
    {
      "matchManagers": [
        "puppet"
      ],
      "groupName": "Puppet updates",
      "addLabels": [
        "puppet"
      ]
    }
  ]
}
