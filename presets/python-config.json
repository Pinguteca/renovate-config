{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label and group Python ecosystem updates",
  "packageRules": [
    {
      "matchCategories": [
        "python"
      ],
      "groupName": "Python updates",
      "addLabels": [
        "python"
      ]
    },
    {
      "matchManagers": [
        "copier"
      ],
      "groupName": "Copier updates",
      "addLabels": [
        "python",
        "copier"
      ]
    }
  ]
}
