{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label and group Python ecosystem updates, keeping majors in their own PR",
  "packageRules": [
    {
      "description": "Label all Python updates",
      "matchCategories": [
        "python"
      ],
      "addLabels": [
        "python"
      ]
    },
    {
      "description": "Group non-major Python updates into a single PR",
      "matchCategories": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "Python updates"
    },
    {
      "description": "Label all Copier template updates",
      "matchManagers": [
        "copier"
      ],
      "addLabels": [
        "python",
        "copier"
      ]
    },
    {
      "description": "Group non-major Copier template updates into a single PR",
      "matchManagers": [
        "copier"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "Copier updates"
    }
  ]
}
