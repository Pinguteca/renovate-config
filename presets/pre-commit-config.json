{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Enable the pre-commit manager, which is off by default, and track prek.toml via a custom manager until Renovate ships native prek support. Remove the customManagers block once native support lands",
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Track hook repository revisions in prek.toml, which the native pre-commit manager does not read",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)prek\\.toml$/"
      ],
      "matchStrings": [
        "repo\\s*=\\s*\"https://github\\.com/(?<depName>[^\"]+)\"\\s+rev\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Label all pre-commit and prek hook updates",
      "matchManagers": [
        "pre-commit",
        "custom.regex"
      ],
      "matchFileNames": [
        "**/.pre-commit-config.yaml",
        "**/.pre-commit-config.yml",
        "**/prek.toml"
      ],
      "addLabels": [
        "pre-commit",
        "git-hooks"
      ]
    },
    {
      "description": "Group non-major pre-commit and prek hook updates into a single PR",
      "matchManagers": [
        "pre-commit",
        "custom.regex"
      ],
      "matchFileNames": [
        "**/.pre-commit-config.yaml",
        "**/.pre-commit-config.yml",
        "**/prek.toml"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "Pre-commit updates"
    },
    {
      "description": "Label the prek runner itself when it is installed as a mise tool",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "prek"
      ],
      "addLabels": [
        "pre-commit",
        "git-hooks"
      ]
    }
  ]
}
