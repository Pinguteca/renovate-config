{
  "extends": [
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions updates",
      "automergeType": "branch",
      "addLabels": [
        "github-action"
      ]
    },
    {
      "matchDepNames": [
        "slsa-framework/slsa-github-generator",
        "/^slsa-framework\\/slsa-github-generator\\//"
      ],
      "pinDigests": false
    }
  ]
}
