{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Pin GitHub Action digests to semver, then label and group workflow updates",
  "extends": [
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions updates",
      "automergeType": "branch",
      "addLabels": [
        "github-action"
      ]
    },
    {
      "matchDepNames": [
        "slsa-framework/slsa-github-generator",
        "/^slsa-framework\\/slsa-github-generator\\//"
      ],
      "pinDigests": false
    }
  ]
}
