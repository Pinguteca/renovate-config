{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Pin GitHub Action digests to semver, then label and group workflow updates",
  "extends": [
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "packageRules": [
    {
      "description": "Label all GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-action"
      ]
    },
    {
      "description": "Group non-major GitHub Actions updates into a single PR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "GitHub Actions updates",
      "automergeType": "branch"
    },
    {
      "description": "SLSA generators must stay on a tag, as the reusable workflow refuses to run from a digest",
      "matchDepNames": [
        "slsa-framework/slsa-github-generator",
        "/^slsa-framework\\/slsa-github-generator\\//"
      ],
      "pinDigests": false
    }
  ]
}
