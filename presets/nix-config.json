{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Enable the Nix manager, which is off by default, then label and group its updates",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Label all Nix updates",
      "matchManagers": [
        "nix"
      ],
      "addLabels": [
        "nix"
      ]
    },
    {
      "description": "Group non-major Nix updates into a single PR",
      "matchManagers": [
        "nix"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "Nix updates"
    }
  ]
}
