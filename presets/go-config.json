{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label and group Go ecosystem updates, including the go directive in go.work",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)go\\.work$/"
      ],
      "matchStrings": [
        "(^|\\n)go (?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\\n"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchFileNames": [
        "**/go.mod",
        "**/go.work"
      ],
      "groupName": "Go updates",
      "addLabels": [
        "go"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
