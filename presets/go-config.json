{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)go\\.work$/"],
      "matchStrings": ["(^|\\n)go (?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\\n"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "groupName": "Go updates",
      "addLabels": [
        "go"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
