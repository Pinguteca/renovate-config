{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label and group Go ecosystem updates, including the go directive in go.work",
  "customManagers": [
    {
      "description": "Track the go directive in go.work, which the gomod manager does not read",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)go\\.work$/"
      ],
      "matchStrings": [
        "(^|\\n)go (?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\\n"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "Label all Go updates. Scoped by file so the custom.regex match cannot capture other presets' custom managers",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchFileNames": [
        "**/go.mod",
        "**/go.work"
      ],
      "addLabels": [
        "go"
      ]
    },
    {
      "description": "Group non-major Go updates into a single PR",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchFileNames": [
        "**/go.mod",
        "**/go.work"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "Go updates"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
