{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared Renovate defaults for the Pinguteca organization.",
    "Options that merely restate a Renovate default are set explicitly on purpose, so that a default changing upstream shows up as a diff here rather than as silent behaviour drift.",
    "Preset order matters: container-config must precede kubernetes-config so Kubernetes regroups images, and hk-config must stay last so its grouping overrides mise-config for hk dependencies."
  ],
  "extends": [
    "config:best-practices",
    "mergeConfidence:all-badges",
    "schedule:automergeOfficeHours",
    "schedule:nonOfficeHours",
    "security:openssf-scorecard",
    "github>Pinguteca/renovate-config//presets/container-config",
    "github>Pinguteca/renovate-config//presets/github-actions-config",
    "github>Pinguteca/renovate-config//presets/pre-commit-config",
    "github>Pinguteca/renovate-config//presets/mise-config",
    "github>Pinguteca/renovate-config//presets/dotnet-config",
    "github>Pinguteca/renovate-config//presets/go-config",
    "github>Pinguteca/renovate-config//presets/python-config",
    "github>Pinguteca/renovate-config//presets/javascript-config",
    "github>Pinguteca/renovate-config//presets/java-config",
    "github>Pinguteca/renovate-config//presets/rust-config",
    "github>Pinguteca/renovate-config//presets/ruby-config",
    "github>Pinguteca/renovate-config//presets/php-config",
    "github>Pinguteca/renovate-config//presets/infrastructure-as-code-config",
    "github>Pinguteca/renovate-config//presets/kubernetes-config",
    "github>Pinguteca/renovate-config//presets/azure-devops-config",
    "github>Pinguteca/renovate-config//presets/azure-pipelines-config",
    "github>Pinguteca/renovate-config//presets/configuration-as-code-config",
    "github>Pinguteca/renovate-config//presets/nix-config",
    "github>Pinguteca/renovate-config//presets/hk-config"
  ],

  "timezone": "Europe/Madrid",
  "semanticCommits": "enabled",
  "branchPrefix": "renovate/",
  "branchNameStrict": true,
  "labels": [
    "renovate"
  ],
  "stopUpdatingLabel": "have-a-break-renovate",

  "draftPR": true,
  "prCreation": "immediate",
  "rebaseWhen": "auto",
  "automerge": false,
  "prBodyNotes": [
    "{{#if isMajor}}:warning: MAJOR UPDATE, may require additional runtime testing to ensure compatibility. :warning:{{/if}}"
  ],

  "rangeStrategy": "auto",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "separateMultipleMajor": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",

  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "vulnerabilityFixStrategy": "lowest",
    "labels": [
      "security"
    ],
    "draftPR": false,
    "automerge": true
  },

  "pin": {
    "commitBody": "[skip ci]",
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "draftPR": false,
    "automerge": true
  },

  "hostRules": [
    {
      "enableHttp2": true
    }
  ],
  "gitIgnoredAuthors": [
    "github-actions[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],

  "packageRules": [
    {
      "description": "Automerge low-risk update types, which cannot be draft PRs because GitHub refuses to merge drafts",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "draftPR": false
    },
    {
      "description": "Automerge development dependencies, which cannot be draft PRs because GitHub refuses to merge drafts",
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "draftPR": false
    }
  ]
}
