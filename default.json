{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "mergeConfidence:all-badges",
    "schedule:automergeOfficeHours",
    "schedule:nonOfficeHours",
    "security:openssf-scorecard",
    "github>Pinguteca/renovate-config//presets/container-config",
    "github>Pinguteca/renovate-config//presets/github-actions-config",
    "github>Pinguteca/renovate-config//presets/pre-commit-config",
    "github>Pinguteca/renovate-config//presets/mise-config",
    "github>Pinguteca/renovate-config//presets/dotnet-config",
    "github>Pinguteca/renovate-config//presets/go-config",
    "github>Pinguteca/renovate-config//presets/python-config",
    "github>Pinguteca/renovate-config//presets/javascript-config",
    "github>Pinguteca/renovate-config//presets/java-config",
    "github>Pinguteca/renovate-config//presets/rust-config",
    "github>Pinguteca/renovate-config//presets/ruby-config",
    "github>Pinguteca/renovate-config//presets/infrastructure-as-code-config",
    "github>Pinguteca/renovate-config//presets/kubernetes-config",
    "github>Pinguteca/renovate-config//presets/configuration-as-code-config",
    "github>Pinguteca/renovate-config//presets/nix-config",
    "github>Pinguteca/renovate-config//presets/hk-config"
  ],
  "timezone": "Europe/Madrid",
  "semanticCommits": "enabled",
  "draftPR": true,
  "automerge": false,
  "labels": [
    "renovate"
  ],
  "stopUpdatingLabel": "have-a-break-renovate",
  "branchPrefix": "renovate/",
  "branchNameStrict": true,
  "rebaseWhen": "auto",
  "prCreation": "immediate",
  "prBodyNotes": [
    "{{#if isMajor}}:warning: MAJOR UPDATE, may require additional runtime testing to ensure compatibility. :warning:{{/if}}"
  ],
  "pin": {
    "commitBody": "[skip ci]",
    "automerge": true
  },
  "hostRules": [
    {
      "enableHttp2": true
    }
  ],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "vulnerabilityFixStrategy": "lowest",
    "labels": [
      "security"
    ],
    "draftPR": false,
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "draftPR": false,
    "automerge": true
  },
  "internalChecksFilter": "strict",
  "rangeStrategy": "auto",
  "separateMinorPatch": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "gitIgnoredAuthors": [
    "github-actions[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "draftPR": false
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "draftPR": false
    }
  ]
}
